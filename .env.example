# Cloud PostgreSQL Database Connection String (Neon / Supabase / Vercel Postgres)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/voyagecraft?schema=public"

# Session & JWT Authentication Secret
JWT_SECRET="voyagecraft-prod-auth-secret-key-32-chars-minimum-hash"

# App Public Domain
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# External API Keys (Kept strictly server-side)
WEATHER_API_KEY=""
GOOGLE_PLACES_API_KEY=""

# SMTP Email Configuration
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""

# Cron Secret Key
CRON_SECRET="voyagecraft-cron-secret-key"
